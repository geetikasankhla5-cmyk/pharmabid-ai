# PharmaBid AI - Environment Configuration Template
# Copy this file to .env and customize for your environment.

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
ENVIRONMENT=development

# Application Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# Database
# Default: Local SQLite database
DATABASE_URL=sqlite:///./backend/data/pharmabid.db

# Storage
STORAGE_DIR=./storage

# Procurement Integrations (India Phase 1)
CPPP_IMPORT_ENABLED=True
GEM_IMPORT_ENABLED=True
TNMSC_IMPORT_ENABLED=True
RMSCL_IMPORT_ENABLED=True
